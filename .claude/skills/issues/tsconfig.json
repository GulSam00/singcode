{
  // 이 스크립트는 앱 빌드(check-types) 범위 밖이라 따로 검사한다:
  //   pnpm exec tsc -p .claude/skills/issues
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["*.mjs"]
}
